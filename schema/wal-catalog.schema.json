{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cntryl/lsm-spec/schema/wal-catalog.schema.json",
  "title": "WalPublicationCatalog",
  "description": "FORMAT 8 cloud WAL publication catalog JSON, format version 3. See format/wal.md §1.2.1.",
  "$defs": {
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "chainLink": {
      "type": "object",
      "required": [
        "id",
        "last_seq",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "last_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "digest": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "maxSequencePerFamily": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "sealedFacts": {
      "type": "object",
      "required": [
        "link",
        "record_count",
        "data_len",
        "max_seq_per_cf"
      ],
      "additionalProperties": false,
      "properties": {
        "link": {
          "type": "object",
          "required": [
            "id",
            "last_seq",
            "digest"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "last_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "digest": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "data_len": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "max_seq_per_cf": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "catalogEntry": {
      "type": "object",
      "required": [
        "epoch",
        "prev",
        "facts",
        "size_bytes",
        "crc32c"
      ],
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "prev": {
          "type": "object",
          "required": [
            "id",
            "last_seq",
            "digest"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "last_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "digest": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        "facts": {
          "type": "object",
          "required": [
            "link",
            "record_count",
            "data_len",
            "max_seq_per_cf"
          ],
          "additionalProperties": false,
          "properties": {
            "link": {
              "type": "object",
              "required": [
                "id",
                "last_seq",
                "digest"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "last_seq": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "digest": {
                  "type": "array",
                  "minItems": 16,
                  "maxItems": 16,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                }
              }
            },
            "record_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "data_len": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "max_seq_per_cf": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "crc32c": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    }
  },
  "type": "object",
  "required": [
    "format_version",
    "fencing_epoch",
    "anchor",
    "next_segment_id",
    "seq_floor",
    "retired_by",
    "segments"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 3
    },
    "fencing_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "anchor": {
      "$ref": "#/$defs/chainLink"
    },
    "next_segment_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "seq_floor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "retired_by": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogEntry"
      }
    }
  },
  "$comment": "JSON Schema cannot enforce chain order, epoch monotonicity, anchor/retired_by correspondence, sequence maxima, or that next_segment_id exceeds the chain head. The reader must enforce these invariants."
}

# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Declare the specification's text formats explicitly.
*.json text eol=lf
*.md text eol=lf
VERSION text eol=lf
LICENSE text eol=lf

# Treat common generated media and archives as binary.
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.tar binary
*.tgz binary
*.zip binary

# Exclude repository-only metadata from source archives.
/.gitignore export-ignore
/.gitattributes export-ignore
